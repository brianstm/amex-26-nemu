      "osm": "Nominatim centroid + Overpass restaurant/cafe/hotel nodes in 1.2 km",
      "formula": "(0.55 + 0.45 * (log1p(arrivals)/log1p(max))^0.4) * relative log OSM amenity within country"
    },
    "acceptance_density": {
      "source": "designed",
      "why_not_osm": "OSM counts mapped amenities, not issuer acceptance. A dense cash strip (Khao San) would look saturated."
    }
